{
  "name": "proofyard",
  "version": "0.0.0",
  "description": "Test React Server Components and Next.js App Router applications with Bun, without launching a browser or Next.js server.",
  "license": "MIT",
  "type": "module",
  "repository": "github:proofyard/proofyard",
  "exports": {
    ".": "./src/index.ts",
    "./preload": "./src/next/preload.ts"
  },
  "scripts": {
    "test": "bun run test:unit && bun run test:poc1 && bun run test:poc2 && bun run test:poc3 && bun run test:poc4 && bun run test:poc5 && bun run test:poc6 && bun run test:src-app && bun run test:ppr",
    "test:unit": "PROOFYARD_NEXT_APP=tests/fixtures/next-app bun test --timeout 20000 --preload ./src/next/preload.ts tests/unit",
    "test:poc1": "bun test --conditions react-server tests/poc/poc1-rsc.test.tsx",
    "test:poc2": "bun test --conditions react-server --preload ./tests/poc/poc2/plugin.ts tests/poc/poc2",
    "test:poc3": "bun test --conditions react-server --preload ./tests/poc/poc2/plugin.ts tests/poc/poc3",
    "bench:api": "PROOFYARD_NEXT_APP=tests/fixtures/next-app bun test --timeout 20000 --preload ./src/next/preload.ts tests/benchmarks/api.test.tsx",
    "bench:dom": "bun test --conditions react-server --preload ./tests/poc/poc2/plugin.ts tests/benchmarks/dom-compare.test.tsx",
    "test:poc4": "bun test --conditions react-server --preload ./tests/poc/poc2/plugin.ts tests/poc/poc4",
    "test:poc5": "PROOFYARD_NEXT_APP=tests/poc/poc5/fixture-app bun test --timeout 20000 --preload ./src/next/preload.ts tests/poc/poc5",
    "test:poc6": "PROOFYARD_NEXT_APP=tests/poc/poc6/fixture-app bun test --timeout 20000 --preload ./src/next/preload.ts tests/poc/poc6",
    "test:src-app": "PROOFYARD_NEXT_APP=tests/src-app/fixture bun test --timeout 20000 --preload ./src/next/preload.ts tests/src-app",
    "test:ppr": "PROOFYARD_NEXT_APP=tests/ppr/fixture bun test --timeout 20000 --preload ./src/next/preload.ts tests/ppr",
    "compat": "bun run compat:next-app && bun run compat:src-app && bun run compat:ppr && bun run compat:errors",
    "compat:next-app": "PROOFYARD_NEXT_APP=tests/fixtures/next-app bun test --timeout 20000 --preload ./src/next/preload.ts tests/compatibility/next-app.test.ts",
    "compat:src-app": "PROOFYARD_NEXT_APP=tests/src-app/fixture bun test --timeout 20000 --preload ./src/next/preload.ts tests/compatibility/src-app.test.ts",
    "compat:ppr": "PROOFYARD_NEXT_APP=tests/ppr/fixture bun test --timeout 20000 --preload ./src/next/preload.ts tests/compatibility/ppr.test.ts",
    "compat:errors": "PROOFYARD_NEXT_APP=tests/poc/poc5/fixture-app bun test --timeout 20000 --preload ./src/next/preload.ts tests/compatibility/errors.test.ts"
  },
  "peerDependencies": {
    "next": "16.4.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20",
    "@miaskiewicz/turbo-dom": "0.5.6",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@testing-library/user-event": "14",
    "@types/bun": "^1.4.3",
    "@types/react": "19",
    "jotai": "^3.0.1",
    "react-redux": "^9.3.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-turbopack": "19.3.1"
  }
}
